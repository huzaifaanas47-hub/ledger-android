{
  "appId": "pk.ledger.app",
  "appName": "Ledger",
  "webDir": "www",
  "server": {
    "url": "https://ledger.example.com",
    "androidScheme": "https",
    "errorPath": "error.html",
    "cleartext": false,
    "allowNavigation": [
      "ledger.example.com"
    ]
  },
  "android": {
    "appendUserAgent": "LedgerApp/1.1.0 (2)",
    "allowMixedContent": false,
    "backgroundColor": "#0b6b4a"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0b6b4a",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#0b6b4a",
      "style": "DARK"
    }
  }
}
